{
  "id": "hymn-396",
  "number": "396",
  "numberDisplay": "396",
  "title": "We'll Work Till Jesus Comes",
  "firstLine": "O land of rest for thee I sigh!",
  "pitchInfo": {
    "raw": "F-4-DO S-2 W-4",
    "key": "F",
    "note": "F",
    "beat": 4,
    "solfege": "DO"
  },
  "thematicRef": "S-2 W-4",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "O land of rest for thee I sigh!",
        "When will the moment come",
        "When I shall lay my armor by,",
        "And dwell in peace at home."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "No tranquil joys on earth I know,",
        "No peaceful, shelt'ring dome,",
        "this world's a wilderness of woe,",
        "This world is not my home."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "To Jesus Christ I fled for rest;",
        "He bade me cease to roam,",
        "And lean for succor on His breast",
        "Till He conducts me home."
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "We'll work till Jesus comes,",
        "We'll work till Jesus comes,",
        "We'll work till Jesus comes,",
        "And we'll be gathered home."
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-396_full.mid",
    "soprano": "/audio/midi/hymn-396_soprano.mid",
    "alto": "/audio/midi/hymn-396_alto.mid",
