  "title": "As The Deer * /",
  "firstLine": "arr. by R. J. Stevens",
  "pitchInfo": {
    "raw": "D-4-MI W-5 D-1",
    "key": "D",
    "note": "D",
    "beat": 4,
    "solfege": "MI"
  },
  "thematicRef": "W-5 D-1",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "arr. by R. J. Stevens"
      ]
    },
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "As the deer pants for the water",
        "So my soul longs after you.",
        "You alone are my heart's desire",
        "And I long to worship You."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "I want You more than gold or silver,",
        "Only You can satisfy.",
        "You alone are the real joygiver,",
        "And the apple of my eye."
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "You alone are my strength, my shiled;",
        "To You alone may my spirit yield,",
        "You alone are my heart's desire",
        "And I long to worship you.",
        "copyright 1984 Maranatha! Music. Adm. The Copyright Co. All Rights Reserved. Used by Permission."
      ]
    }
  ],
