{
  "id": "hymn-535",
  "number": "535",
  "numberDisplay": "535",
  "title": "Savior, Mine, I Remember Thee * /",
  "firstLine": "St. 4 by Dane K. Shepard",
  "pitchInfo": {
    "raw": "D-4-MI L-1",
    "key": "D",
    "note": "D",
    "beat": 4,
    "solfege": "MI"
  },
  "thematicRef": "L-1",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "St. 4 by Dane K. Shepard"
      ]
    },
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Savior, mine, I remember Thee",
        "Suff'ring on that cruel tree;",
        "Now I seek to do Thy will",
        "And in love Thy word fulfill."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "Glorious Savior, Lamb of God,",
        "On this earth Thy feet once trod;",
        "God as man perfect sacrifice;",
        "On the cross You paid sin's price."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "Blood and water flowing down,",
        "Granting me a priceless crown;",
        "Hand and feet were nailed by me;",
        "From my guilt You set me free!"
      ]
    },
    {
      "type": "verse",
      "number": 4,
      "lines": [
        "Savior, mine, remember me",
        "As I serve and follow Thee;",
        "Dead to self, my cross I bear;",
        "Life indeed! with Thee I share.",
        "Copyright 1993 by Vesta A. McDaniel and Dane K. Shepard. All Rights Reserved."
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-535_full.mid",
