{
  "id": "hymn-315",
  "number": "315",
  "numberDisplay": "315",
  "title": "O Why Not Tonight",
  "firstLine": "O, do not let the word depart,",
  "pitchInfo": {
    "raw": "Eb-4-DO I-1",
    "key": "Eb",
    "note": "Eb",
    "beat": 4,
    "solfege": "DO"
  },
  "thematicRef": "I-1",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "O, do not let the word depart,",
        "And close thine eyes against the light;",
        "Poor sinner, harden not your heart,",
        "Be saved, O, tonight."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "Tomorrow's sun may never rise,",
        "To bless thy long deluded sight;",
        "This is the time, O, then be wise,",
        "Be saved, O, tonight."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "Our blessed Lord refuses none,",
        "Who would to Him their souls unite,",
        "Believe, obey, the work is done,",
        "Be saved, O, tonight."
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "O, why not tonight?",
        "O, why not tonight?",
        "Wilt thou be saved?",
        "Then why not tonight?"
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-315_full.mid",
    "soprano": "/audio/midi/hymn-315_soprano.mid",
    "alto": "/audio/midi/hymn-315_alto.mid",
    "tenor": "/audio/midi/hymn-315_tenor.mid",
    "bass": "/audio/midi/hymn-315_bass.mid"
  }
}
