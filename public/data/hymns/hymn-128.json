{
  "id": "hymn-128",
  "number": "128",
  "numberDisplay": "128",
  "title": "Take My Life, And Let It Be",
  "firstLine": "Take my life, and let it be,",
  "pitchInfo": {
    "raw": "A-3-SOL C-16 D-1",
    "key": "A",
    "note": "A",
    "beat": 3,
    "solfege": "SOL"
  },
  "thematicRef": "C-16 D-1",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Take my life, and let it be,",
        "Consecrated, Lord, to Thee;",
        "Take my hands, and let them move",
        "At the impulse of Thy love."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "Take my will and make it Thine,",
        "It shall be no longer mine;",
        "Take my heart, it is Thine own,",
        "It shall be Thy royal throne."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "Take my love; my Lord I pour",
        "At Thy feet its treasure-store;",
        "Take myself, and I will be",
        "Ever, only, all for Thee."
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-128_full.mid",
    "soprano": "/audio/midi/hymn-128_soprano.mid",
    "alto": "/audio/midi/hymn-128_alto.mid",
    "tenor": "/audio/midi/hymn-128_tenor.mid",
    "bass": "/audio/midi/hymn-128_bass.mid"
  }
}
