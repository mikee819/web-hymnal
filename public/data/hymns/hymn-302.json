{
  "id": "hymn-302",
  "number": "302",
  "numberDisplay": "302",
  "title": "Blest Be The Tie",
  "firstLine": "Blest be the tie that binds",
  "pitchInfo": {
    "raw": "F-3-MI C-14 L-2",
    "key": "F",
    "note": "F",
    "beat": 3,
    "solfege": "MI"
  },
  "thematicRef": "C-14 L-2",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Blest be the tie that binds",
        "Our hearts in Christian love;",
        "The fellowship of kindred minds",
        "Is like to that above."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "Before our Father's throne",
        "We pour our ardent pray'rs;",
        "Our fears, our hopes, our aims are one,",
        "Our comforts and our cares."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "We share our mutual woes,",
        "Our mutual burdens bear;",
        "And often for each other flows",
        "The sympathizing tear."
      ]
    },
    {
      "type": "verse",
      "number": 4,
      "lines": [
        "When we asunder part,",
        "It gives us inward pain;",
        "But we shall still be joined in heart,",
        "And hope to meet again."
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-302_full.mid",
    "soprano": "/audio/midi/hymn-302_soprano.mid",
    "alto": "/audio/midi/hymn-302_alto.mid",
    "tenor": "/audio/midi/hymn-302_tenor.mid",
    "bass": "/audio/midi/hymn-302_bass.mid"
  }
}
