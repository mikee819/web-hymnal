  "title": "His Sheep Am I * /",
  "firstLine": "st. 2, Dane K. Shepard",
  "pitchInfo": {
    "raw": "Eb-4-DO C-11",
    "key": "Eb",
    "note": "Eb",
    "beat": 4,
    "solfege": "DO"
