{
  "id": "hymn-515",
  "number": "515",
  "numberDisplay": "515",
  "title": "With One Accord * /",
  "firstLine": "arr. by R. J. Stevens",
  "pitchInfo": {
    "raw": "Eb-4-DO D-1 P-3",
    "key": "Eb",
    "note": "Eb",
    "beat": 4,
    "solfege": "DO"
  },
  "thematicRef": "D-1 P-3",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "arr. by R. J. Stevens"
      ]
    },
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "With one accord we pray;",
        "\"Lord, help us learn this day",
        "That ev'ry step we dare to take,",
        "Must be within \"The Way'!\""
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "\"Lord, help us now to know",
        "Our Christ who loves us so,\"",
        "May we with fervent effort make,",
        "Our love for Him to grow!"
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "\"Lord, when we fail to see,",
        "All blessings come from Thee,",
        "Remove from us our love of self,",
        "And turn our eyes to Thee!\"",
        "A-men",
        "Copyright 1990 by D. Douglas Hoffman. All Rights Reserved."
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-515_full.mid",
