  "title": "Glory! Glory! Hallelujah! 571 / *",
  "firstLine": "Composer; William Steffe",
  "pitchInfo": {
    "raw": "Bb-4-SOL P-2",
    "key": "Bb",
    "note": "Bb",
    "beat": 4,
    "solfege": "SOL"
