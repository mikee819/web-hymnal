{
  "id": "hymn-220",
  "number": "220",
  "numberDisplay": "220",
  "title": "No Night There",
  "firstLine": "In the land of fadeless day,",
  "pitchInfo": {
    "raw": "Eb-3-DO C-15 H-2",
    "key": "Eb",
    "note": "Eb",
    "beat": 3,
    "solfege": "DO"
  },
  "thematicRef": "C-15 H-2",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "In the land of fadeless day,",
        "Lies the \"city foursquare,\"",
        "It shall never pass away,",
        "And there is \"no night there.\""
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "All the gates of pearl are made,",
        "In the \"city foursquare,\"",
        "All the streets with gold are laid,",
        "And there is \"no night there.\""
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "There they need no sunshine bright,",
        "In that \"city foursquare,\"",
        "For the Lamb is all the light,",
        "And there is \"no night there.\""
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "God shall \"wipe away all tear;\"",
        "There's no death, no pain, nor fears;",
        "And they count not time by years,",
        "For there is \"no night there.\""
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-220_full.mid",
    "soprano": "/audio/midi/hymn-220_soprano.mid",
    "alto": "/audio/midi/hymn-220_alto.mid",
    "tenor": "/audio/midi/hymn-220_tenor.mid",
    "bass": "/audio/midi/hymn-220_bass.mid"
  }
}
