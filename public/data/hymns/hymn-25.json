{
  "id": "hymn-25",
  "number": "25",
  "numberDisplay": "25",
  "title": "Wonderful Jesus",
  "firstLine": "Wonderful Jesus! glorious friend!",
  "pitchInfo": {
    "raw": "G-3-MI P-2",
    "key": "G",
    "note": "G",
    "beat": 3,
    "solfege": "MI"
  },
  "thematicRef": "P-2",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Wonderful Jesus! glorious friend!",
        "He will be with me unto the end,"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "eering, upholding, keeping me strong,",
        "Fearless and loyal, shielding from wrong."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "Wonderful Jesus! showing the way",
        "Into the blessed kingdom of day;",
        "Guiding my footsteps, holding control,",
        "Making me happy, keeping me whole."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "Wonderful Jesus! All thru the night",
        "He will enfold me, giving me light;",
        "Then when the morning breaks on the shore,",
        "This He will whisper, \"Mine ever more.\""
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "Wonderful Jesus! marvelous King!",
        "Ever His praise my spirit shall sing,",
        "When I behold His glorified face,",
        "How I shall praise His wonderful grace."
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-25_full.mid",
    "soprano": "/audio/midi/hymn-25_soprano.mid",
    "alto": "/audio/midi/hymn-25_alto.mid",
    "tenor": "/audio/midi/hymn-25_tenor.mid",
    "bass": "/audio/midi/hymn-25_bass.mid"
  }
}
