{
  "id": "hymn-521",
  "number": "521",
  "numberDisplay": "521",
  "title": "Jesus My Savior, Look On Me * /",
  "firstLine": "Jesus, my Savior, look on me,",
  "pitchInfo": {
    "raw": "D-4-SOL D-1",
    "key": "D",
    "note": "D",
    "beat": 4,
    "solfege": "SOL"
  },
  "thematicRef": "D-1",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Jesus, my Savior, look on me,",
        "For I am weary and oppressed;",
        "I come to cast myself on Thee;",
        "Thou art my Rest."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "Look down on me, for I am weak;",
        "I feel the toilsome journey's length:",
        "Thine aid omnipotent I see:",
        "Thou art my Strength."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "I am bewildered on my way,",
        "Dark and tempest'ous is the night;",
        "O send Thou forth some cheering ray!",
        "Thou art my Light."
      ]
    },
    {
      "type": "verse",
      "number": 4,
      "lines": [
        "Thou wilt my ev'ry want supply,",
        "E'en to the end, what-e'er befall;",
        "Thru life, in death, eternally,",
        "Thou art my All.",
        "Amen."
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-521_full.mid",
    "soprano": "/audio/midi/hymn-521_soprano.mid",
    "alto": "/audio/midi/hymn-521_alto.mid",
    "tenor": "/audio/midi/hymn-521_tenor.mid",
    "bass": "/audio/midi/hymn-521_bass.mid"
  }
}
