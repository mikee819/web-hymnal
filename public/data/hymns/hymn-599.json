    {
      "type": "verse",
      "number": 1,
      "lines": [
        "arr. by R. J. Stevens",
        "Scripture; Lamentaions 3:56"
      ]
    },
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Please hear our prayer, holy God,",
        "Oh let our words come to Thee.",
        "We bow down in reve'rence",
        "For we believe."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "No we approach in Thy Love;",
        "We know Thou hearest our plea",
        "We bow down in reve'rence",
        "For we believe."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "For humbly now do we bow",
        "Before Thy throne praising Thee",
        "We bow down in reve'rence",
        "For we believe.",
        "Copyright 1989 Glenda Barnhart Schales. All Rights Reserved."
      ]
    }
  ],
