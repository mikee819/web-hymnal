{
  "id": "hymn-394",
  "number": "394",
  "numberDisplay": "394",
  "title": "Love One Another",
  "firstLine": "Angry words! O let them never",
  "pitchInfo": {
    "raw": "Db-3-SOL L-2 U-1",
    "key": "Db",
    "note": "Db",
    "beat": 3,
    "solfege": "SOL"
  },
  "thematicRef": "L-2 U-1",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Angry words! O let them never",
        "From the tongue unbridled slip;",
        "May the heart's best impulse ever"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "eck them ere they soil the lip."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "Love is much too pure and holy,",
        "Friendship is too sacred far,",
        "For a moment's reckless folly",
        "Thus to desolate and mar."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "Angry words are lightly spoken,",
        "Bitt'rest tho'ts are rashly stirred,",
        "Brightest links of life are broken,",
        "By a single angry word."
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "\"Love one another,\" thus saith the Savior;"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "ildren, obey the Father's blest command;",
        "\"Love one another,\" thus saith the Savior;"
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "ildren, obey His blest command."
      ]
    }
  ],
