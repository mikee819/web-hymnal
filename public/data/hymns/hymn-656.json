  "title": "All Life Comes From Thee * /",
  "firstLine": "Scripture; Job 12:10",
  "pitchInfo": {
    "raw": "F-4-SOL P-2",
    "key": "F",
    "note": "F",
    "beat": 4,
    "solfege": "SOL"
  },
  "thematicRef": "P-2",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Scripture; Job 12:10"
      ]
    },
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Lord God Almighty,",
        "Thy strong hand created sky and sea,",
        "And lifted from deep sea, dry land,",
        "And caused all life to be."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "Lord God of Love, Thy tender hand,",
        "Reached down to man in sin,",
        "And raised him up in Christ to stand,",
        "Alive and pure again."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "Lord God Immortal,",
        "Soon thy hand shall beckon us to Thee,",
        "Ascending to an unknown land,",
        "To live eternally."
      ]
    },
    {
      "type": "verse",
      "number": 4,
      "lines": [
        "Lord God our Maker,",
        "Savior, and Eternal Deity,",
        "We reach up for Thy mighty hand,",
        "For all life comes from Thee. Amen.",
        "Copyright 1993 by Michael & Sarah Hersey.l All Rights Reserved."
      ]
    }
  ],
  "tracks": {}
}
