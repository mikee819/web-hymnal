{
  "id": "hymn-191",
  "number": "191",
  "numberDisplay": "191",
  "title": "Heaven Holds All To Me",
  "firstLine": "Earth holds no treasures but perish with using",
  "pitchInfo": {
    "raw": "Ab-2-MI H-2 R-3",
    "key": "Ab",
    "note": "Ab",
    "beat": 2,
    "solfege": "MI"
  },
  "thematicRef": "H-2 R-3",
  "tuneRef": null,
  "sections": [
    {
      "type": "verse",
      "number": 1,
      "lines": [
        "Earth holds no treasures but perish with using",
        "However precious they be;",
        "Yet there's a country to which I am going,",
        "Heaven holds all to me."
      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        "Out on the hills of that wonderful country,",
        "Happy, contented and free,",
        "Angels are waiting and watching my coming,",
        "Heaven holds all to me."
      ]
    },
    {
      "type": "verse",
      "number": 3,
      "lines": [
        "Why should I long for the world and its sorrows,",
        "When in that home o'er the sea",
        "Millions are singing the wonderful story,",
        "Heaven holds all to me."
      ]
    },
    {
      "type": "chorus",
      "lines": [
        "Heaven holds all to me,",
        "Brighter its glory will be;",
        "Joy without measure, will be my treasure,",
        "Heaven holds all to me."
      ]
    }
  ],
  "tracks": {
    "full": "/audio/midi/hymn-191_full.mid",
    "soprano": "/audio/midi/hymn-191_soprano.mid",
    "alto": "/audio/midi/hymn-191_alto.mid",
    "tenor": "/audio/midi/hymn-191_tenor.mid",
    "bass": "/audio/midi/hymn-191_bass.mid"
  }
}
